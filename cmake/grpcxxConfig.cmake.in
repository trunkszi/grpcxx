@PACKAGE_INIT@
if(NOT DEFINED CMAKE_CXX_SCAN_FOR_MODULES)
  set(CMAKE_CXX_SCAN_FOR_MODULES OFF)
endif()
include(CMakeFindDependencyMacro)
find_dependency(uarch CONFIG)
find_dependency(uring CONFIG)
find_dependency(cares CONFIG)
find_dependency(nexora CONFIG)
find_dependency(fmt CONFIG)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/GrpcxxCompressionDependencies.cmake")
if(@GRPCXX_ENABLE_PROTOBUF@)
  set(protobuf_MODULE_COMPATIBLE ON)
  find_package(Protobuf CONFIG QUIET)
  if(NOT Protobuf_FOUND)
    find_dependency(Protobuf)
  endif()
endif()
if(@GRPCXX_ENABLE_CAPNP@)
  # CapnProto 1.0.2's C++ probe redeclares a GCC atomic builtin with an incompatible signature.
  if(NOT CMAKE_C_COMPILER_LOADED AND NOT DEFINED FOUND_LIBATOMIC)
    include(CMakePushCheckState)
    include(CheckCXXSourceCompiles)
    cmake_push_check_state(RESET)
    set(CMAKE_REQUIRED_LIBRARIES atomic)
    check_cxx_source_compiles("extern \"C\" unsigned long long grpcxx_atomic_load(const volatile void*, int) asm(\"__atomic_load_8\");
      int main() { unsigned long long value = 0; return static_cast<int>(grpcxx_atomic_load(&value, 0)); }"
      FOUND_LIBATOMIC)
    cmake_pop_check_state()
  endif()
  find_dependency(CapnProto CONFIG)
endif()
if(@GRPCXX_ENABLE_FORY@)
  find_package(fory CONFIG QUIET)
  if(NOT TARGET fory::serialization)
    find_dependency(Fory CONFIG)
  endif()
  set_property(TARGET fory::serialization APPEND PROPERTY INTERFACE_COMPILE_OPTIONS -frtti)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/grpcxx-targets.cmake")
include("${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@/grpcxx/tools/GrpcxxCodegen.cmake")
check_required_components(grpcxx)
