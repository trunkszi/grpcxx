cmake_minimum_required(VERSION 3.28)

# Configure the repository's canonical targets when this example is the entry point.
function(order_service_load_canonical_dependencies)
  get_filename_component(repo_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../.." ABSOLUTE)
  if(NOT TARGET grpcxx::core)
    set(GRPCXX_BUILD_TESTING OFF)
    set(GRPCXX_BUILD_BENCHMARKS OFF)
    set(GRPCXX_BUILD_EXAMPLES OFF)
    add_subdirectory("${repo_root}" "${CMAKE_CURRENT_BINARY_DIR}/canonical")
  endif()
  if(NOT TARGET grpcxx::h2)
    add_subdirectory("${repo_root}/src/grpcxx/h2" "${CMAKE_CURRENT_BINARY_DIR}/canonical-h2")
  endif()
  if(NOT TARGET grpcxx::reflection)
    add_subdirectory("${repo_root}/src/grpcxx/reflection" "${CMAKE_CURRENT_BINARY_DIR}/canonical-reflection")
  endif()
  if(NOT TARGET grpcxx::streaming)
    set(GRPCXX_BUILD_TESTING OFF)
    set(GRPCXX_BUILD_EXAMPLES OFF)
    add_subdirectory("${repo_root}/src/grpcxx/streaming" "${CMAKE_CURRENT_BINARY_DIR}/canonical-streaming")
  endif()
endfunction()
